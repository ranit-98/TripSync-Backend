generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum TripStatus {
  active
  archived
}

enum TripMemberRole {
  collaborator
  viewer
}

enum InviteStatus {
  pending
  accepted
  declined
  expired
}

enum SettlementStatus {
  pending
  paid
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  email            String           @unique
  avatarUrl        String?          @map("avatar_url") @db.Text
  passwordHash     String           @map("password_hash")
  role             UserRole         @default(user)
  refreshTokenHash String?          @map("refresh_token_hash") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  ownedTrips       Trip[]           @relation("TripOwner")
  memberships      TripMember[]
  invitesSent      TripInvite[]     @relation("InviteSender")
  expensesPaid     Expense[]        @relation("ExpensePayer")
  expenseSplits    ExpenseSplit[]
  settlementsFrom  Settlement[]     @relation("SettlementFrom")
  settlementsTo    Settlement[]     @relation("SettlementTo")
  documentsCreated DocumentFolder[] @relation("FolderCreator")
  documents        Document[]       @relation("DocumentUploader")
  photos           Photo[]          @relation("PhotoUploader")
  messages         Message[]        @relation("MessageSender")
  notifications    Notification[]
  activityLogs     ActivityLog[]    @relation("ActivityActor")

  @@map("users")
}

model Trip {
  id             String           @id @default(uuid()) @db.Uuid
  ownerId        String           @map("owner_id") @db.Uuid
  owner          User             @relation("TripOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title          String
  destination    String
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime         @map("end_date") @db.Date
  currency       String           @default("USD")
  budget         Decimal          @default(0) @db.Decimal(12, 2)
  coverUrl       String?          @map("cover_url")
  styles         String[]         @default([])
  status         TripStatus       @default(active)
  members        TripMember[]
  invites        TripInvite[]
  days           TripDay[]
  activities     Activity[]
  expenses       Expense[]
  settlements    Settlement[]
  locations      Location[]
  folders        DocumentFolder[]
  documents      Document[]
  photos         Photo[]
  messages       Message[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("trips")
}

model TripMember {
  id       String         @id @default(uuid()) @db.Uuid
  tripId   String         @map("trip_id") @db.Uuid
  trip     Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId   String         @map("user_id") @db.Uuid
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TripMemberRole
  joinedAt DateTime       @default(now()) @map("joined_at")

  @@unique([tripId, userId])
  @@map("trip_members")
}

model TripInvite {
  id        String         @id @default(uuid()) @db.Uuid
  tripId    String         @map("trip_id") @db.Uuid
  trip      Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  email     String
  role      TripMemberRole
  status    InviteStatus   @default(pending)
  invitedBy String         @map("invited_by") @db.Uuid
  inviter   User           @relation("InviteSender", fields: [invitedBy], references: [id])
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("trip_invites")
}

model TripDay {
  id         String     @id @default(uuid()) @db.Uuid
  tripId     String     @map("trip_id") @db.Uuid
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date
  title      String?
  position   Int        @default(0)
  activities Activity[]

  @@map("trip_days")
}

model Activity {
  id          String    @id @default(uuid()) @db.Uuid
  tripId      String    @map("trip_id") @db.Uuid
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayId       String?   @map("day_id") @db.Uuid
  day         TripDay?  @relation(fields: [dayId], references: [id], onDelete: SetNull)
  title       String
  description String?
  location    String?
  startTime   String?   @map("start_time")
  endTime     String?   @map("end_time")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("activities")
}

model Expense {
  id           String         @id @default(uuid()) @db.Uuid
  tripId       String         @map("trip_id") @db.Uuid
  trip         Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  description  String
  category     String
  amount       Decimal        @db.Decimal(12, 2)
  currency     String         @default("USD")
  paidByUserId String         @map("paid_by_user_id") @db.Uuid
  paidBy       User           @relation("ExpensePayer", fields: [paidByUserId], references: [id])
  expenseDate  DateTime       @map("expense_date") @db.Date
  notes        String?
  splits       ExpenseSplit[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("expenses")
}

model ExpenseSplit {
  id        String  @id @default(uuid()) @db.Uuid
  expenseId String  @map("expense_id") @db.Uuid
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id") @db.Uuid
  user      User    @relation(fields: [userId], references: [id])
  amount    Decimal @db.Decimal(12, 2)

  @@map("expense_splits")
}

model Settlement {
  id         String           @id @default(uuid()) @db.Uuid
  tripId     String           @map("trip_id") @db.Uuid
  trip       Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUserId String           @map("from_user_id") @db.Uuid
  fromUser   User             @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUserId   String           @map("to_user_id") @db.Uuid
  toUser     User             @relation("SettlementTo", fields: [toUserId], references: [id])
  amount     Decimal          @db.Decimal(12, 2)
  status     SettlementStatus @default(pending)
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@map("settlements")
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  position  Int      @default(0)

  @@map("locations")
}

model DocumentFolder {
  id          String     @id @default(uuid()) @db.Uuid
  tripId      String     @map("trip_id") @db.Uuid
  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdBy   String     @map("created_by") @db.Uuid
  creator     User       @relation("FolderCreator", fields: [createdBy], references: [id])
  documents   Document[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("document_folders")
}

model Document {
  id               String         @id @default(uuid()) @db.Uuid
  folderId         String         @map("folder_id") @db.Uuid
  folder           DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  tripId           String         @map("trip_id") @db.Uuid
  trip             Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  displayName      String         @map("display_name")
  originalFileName String         @map("original_file_name")
  objectKey        String         @map("object_key")
  url              String
  mimeType         String         @map("mime_type")
  size             Int
  uploadedBy       String         @map("uploaded_by") @db.Uuid
  uploader         User           @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("documents")
}

model Photo {
  id               String   @id @default(uuid()) @db.Uuid
  tripId           String   @map("trip_id") @db.Uuid
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  caption          String?
  objectKey        String   @map("object_key")
  url              String
  originalFileName String   @map("original_file_name")
  mimeType         String   @map("mime_type")
  size             Int
  uploadedBy       String   @map("uploaded_by") @db.Uuid
  uploader         User     @relation("PhotoUploader", fields: [uploadedBy], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("photos")
}

model Message {
  id          String              @id @default(uuid()) @db.Uuid
  tripId      String              @map("trip_id") @db.Uuid
  trip        Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  senderId    String              @map("sender_id") @db.Uuid
  sender      User                @relation("MessageSender", fields: [senderId], references: [id])
  body        String              @db.Text
  attachments MessageAttachment[]
  createdAt   DateTime            @default(now()) @map("created_at")

  @@map("messages")
}

model MessageAttachment {
  id               String  @id @default(uuid()) @db.Uuid
  messageId        String  @map("message_id") @db.Uuid
  message          Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  objectKey        String  @map("object_key")
  url              String
  originalFileName String  @map("original_file_name")
  mimeType         String  @map("mime_type")
  size             Int

  @@map("message_attachments")
}

model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId       String?   @map("trip_id") @db.Uuid
  trip         Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type         String
  title        String
  body         String?   @db.Text
  resourceType String?   @map("resource_type")
  resourceId   String?   @map("resource_id")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String?  @map("trip_id") @db.Uuid
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actorId   String?  @map("actor_id") @db.Uuid
  actor     User?    @relation("ActivityActor", fields: [actorId], references: [id])
  action    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}
